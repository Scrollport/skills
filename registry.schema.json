{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Scrollport/skills/blob/main/registry.schema.json",
  "title": "Scrollport Skill registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "skills"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "repository": { "const": "https://github.com/Scrollport/skills" },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "status", "customer_proven"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "path": { "type": "string" },
          "status": { "enum": ["draft", "verified"] },
          "customer_proven": { "type": "boolean" }
        }
      }
    }
  }
}
